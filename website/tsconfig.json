{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"],
    "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "jsxImportSource": "preact",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowJs": true, "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src"]
}
