    {
      "id": "loneSurrogates",
      "title": "JSON strings with a lone surrogate: kept as sent, replaced with U+FFFD, or refused",
      "level": "INFO",
      "spec": [],
      "basis": "§3.5.3 accepts \"only valid Unicode string input values\" without defining one, and calls a String \"a sequence of Unicode code points\", which a lone surrogate is. §3.5.5 says nothing about Unicode. RFC 8259 §8.2 calls the behaviour of software that receives such a string unpredictable. Coercion.tla refuses it, but the check also passes the value kept as sent and the value with U+FFFD, and records which happened. It never fails the run.",
      "status": "fail",
      "cases": 2,
      "failing": 2,
      "failingDraftOnly": 0
    },
    {
      "id": "jsonNumbers",
      "title": "JSON numbers a double can't hold: read exactly, read as binary64, or refused",
      "level": "INFO",
      "spec": [],
      "basis": "Not a GraphQL rule: RFC 8259 §6 lets a JSON parser limit the range and precision of numbers. Vectors whose answer depends on that count here, never against Float or ID, unless the adapter claims exact-numbers.",
      "status": "untested",
      "cases": 0,
      "failing": 0,
      "failingDraftOnly": 0
    }
