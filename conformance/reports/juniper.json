    {
      "id": "intFraction",
      "title": "A fraction returned for an Int (1.2) raises an execution error instead of being truncated",
      "level": "SHOULD",
      "spec": [
        {
          "number": "3.5.1",
          "title": "Int",
          "url": "https://spec.graphql.org/draft/#sec-Int"
        },
        {
          "number": "6.4.3",
          "title": "Value Completion",
          "url": "https://spec.graphql.org/draft/#sec-Value-Completion"
        }
      ],
      "basis": "The level is contested. §3.5.1 states a rule with must: services \"may coerce non-integer internal values to integers when reasonable without losing information, otherwise they must raise an execution error\". Truncating 1.2 loses information, so on that reading the must applies. But the example that applies the rule to this very case says should: \"a floating-point number 1.2 should raise an execution error instead of being truncated to 1\". Where the level is in doubt, the kit takes the weaker one, so this is a SHOULD. October 2021 has the same sentences, with \"field error\".",
      "status": "fail",
      "cases": 476,
      "failing": 403
