{
  "name": "graphql-tla",
  "version": "0.0.0",
  "private": true,
  "description": "GraphQL execution semantics as TLA+ specifications, written in TypeScript and model checked with tla-ts",
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:execution": "tla-ts specs/execution.ts",
    "check:mutation": "tla-ts specs/mutation.ts",
    "check:defer": "tla-ts specs/defer.ts",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "tla-ts": "0.0.10",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
