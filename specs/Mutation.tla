---- MODULE Mutation ----
EXTENDS Integers, Sequences, FiniteSets, TLC
VARIABLES likeCount, phase, observed, failed, likes
vars == <<likeCount, phase, observed, failed, likes>>
SERIAL ==
  TRUE
before ==
  [first |-> {}, second |-> {"first"}, third |-> {"first", "second"}]
ROOT_FIELDS ==
  {"first", "second", "third"}
isFinished_1 ==
  \A f_3 \in ROOT_FIELDS : phase[f_3] = "done"
succeededBefore(field_3) ==
  Cardinality(before[field_3] \ failed)
Init ==
  /\ likeCount = 0
  /\ phase = [first |-> "idle", second |-> "idle", third |-> "idle"]
  /\ observed = [first |-> 0, second |-> 0, third |-> 0]
  /\ failed = {}
  /\ likes = [first |-> 0, second |-> 0, third |-> 0]
beginResolver(field) ==
  /\ ~(phase[field] # "idle")
  /\ ~(SERIAL /\ (~(\A f_1 \in before[field] : phase[f_1] = "done")))
  /\ phase' = [phase EXCEPT ![field] = "read"]
  /\ observed' = [observed EXCEPT ![field] = likeCount]
  /\ UNCHANGED <<likeCount, failed, likes>>
writeEffect(field_1, raises) ==
  /\ ~(phase[field_1] # "read")
  /\ IF raises
     THEN /\ phase' = [phase EXCEPT ![field_1] = "written"]
          /\ failed' = failed \cup {field_1}
          /\ UNCHANGED <<likeCount, observed, likes>>
     ELSE /\ likeCount' = observed[field_1] + 1
          /\ phase' = [phase EXCEPT ![field_1] = "written"]
          /\ UNCHANGED <<observed, failed, likes>>
completeSelection(field_2) ==
  /\ ~(phase[field_2] # "written")
  /\ IF ~(field_2 \in failed)
     THEN /\ phase' = [phase EXCEPT ![field_2] = "done"]
          /\ likes' = [likes EXCEPT ![field_2] = likeCount]
          /\ UNCHANGED <<likeCount, observed, failed>>
     ELSE /\ phase' = [phase EXCEPT ![field_2] = "done"]
          /\ UNCHANGED <<likeCount, observed, failed, likes>>
isFinished ==
  \A f_2 \in ROOT_FIELDS : phase[f_2] = "done"
Next ==
  \/ \E field \in {"first", "second", "third"} : beginResolver(field)
  \/ \E field_1 \in {"first", "second", "third"}, raises \in BOOLEAN : writeEffect(field_1, raises)
  \/ \E field_2 \in {"first", "second", "third"} : completeSelection(field_2)
  \/ isFinished /\ UNCHANGED vars
Spec ==
  /\ Init
  /\ [][Next]_vars
oneAtATime ==
  \A a \in ROOT_FIELDS : \A b \in ROOT_FIELDS : ((((a = b) \/ (phase[a] = "idle")) \/ (phase[a] = "done")) \/ (phase[b] = "idle")) \/ (phase[b] = "done")
noLostUpdates ==
  (~isFinished_1) \/ (likeCount = Cardinality(ROOT_FIELDS \ failed))
responseIsSerial ==
  (~isFinished_1) \/ (\A f_4 \in ROOT_FIELDS : (f_4 \in failed) \/ (likes[f_4] = (succeededBefore(f_4) + 1)))
====
