writeEffect(field_1, raises) ==
  /\ ~(phase[field_1] # "read")
  /\ IF raises
     THEN LET field_2 == field_1
          IN  IF nonNull[field_2]
              THEN /\ phase' = [phase EXCEPT ![field_1] = "done"]
                   /\ failed' = failed \cup {field_2}
                   /\ dataIsNull' = TRUE
                   /\ UNCHANGED <<nonNull, stopsAfterNullRoot, likeCount, observed, effected, likes>>
              ELSE /\ phase' = [phase EXCEPT ![field_1] = "done"]
                   /\ failed' = failed \cup {field_2}
                   /\ UNCHANGED <<nonNull, stopsAfterNullRoot, likeCount, observed, effected, likes, dataIsNull>>
     ELSE /\ likeCount' = observed[field_1] + 1
          /\ phase' = [phase EXCEPT ![field_1] = "written"]
          /\ effected' = effected \cup {field_1}
          /\ UNCHANGED <<nonNull, stopsAfterNullRoot, observed, failed, likes, dataIsNull>>
completeSelection(field_3, likesFails) ==
