Init ==
  /\ fixture \in {"fragments", "lists", "nullPropagation"}
  /\ variant \in {"reportAll", "filterNulled", "cancelNulled"}
  /\ started = FALSE
  /\ running = {}
  /\ outcomes = <<>>
  /\ errors = <<>>
  /\ sent = FALSE
  /\ sentData = NULL
  /\ sentErrors = <<>>
start ==
  /\ ~started
  /\ LET roots == (LET sequence == [index_2 \in DOMAIN rootGroups |-> <<rootGroups[index_2].key>>] IN {sequence[index_3] : index_3 \in DOMAIN sequence})
     IN  /\ started' = TRUE
         /\ running' = roots
         /\ UNCHANGED <<fixture, variant, outcomes, errors, sent, sentData, sentErrors>>
settle(path, outcome) ==
  LET reported == raisesError(path, outcome) /\ ((variant = "reportAll") \/ (~isInNulledSubtree(path)))
      children == (LET sequence_11 == childPaths(path, positionOf(path), outcome) IN {sequence_11[index_20] : index_20 \in DOMAIN sequence_11})
  IN  IF reported
      THEN /\ running' = (running \ {path}) \cup children
           /\ outcomes' = (path :> outcome) @@ outcomes
           /\ errors' = Append(errors, path)
           /\ UNCHANGED <<fixture, variant, started, sent, sentData, sentErrors>>
      ELSE /\ running' = (running \ {path}) \cup children
           /\ outcomes' = (path :> outcome) @@ outcomes
           /\ UNCHANGED <<fixture, variant, started, errors, sent, sentData, sentErrors>>
cancel(path_8) ==
  /\ (~(variant # "cancelNulled")) /\ isInNulledSubtree(path_8)
  /\ running' = running \ {path_8}
  /\ UNCHANGED <<fixture, variant, started, outcomes, errors, sent, sentData, sentErrors>>
respond ==
  /\ (started /\ (~sent)) /\ (~(rootStatus = "pending"))
  /\ LET data == responseData
     IN  /\ sent' = TRUE
         /\ sentData' = data
         /\ sentErrors' = errors
         /\ UNCHANGED <<fixture, variant, started, running, outcomes, errors>>
isFinished ==
  sent /\ (Cardinality(running) = 0)
Next ==
  \/ start
  \/ \E path \in running : \E outcome \in choicesFor(positionOf(path)) : settle(path, outcome)
  \/ \E path_8 \in running : cancel(path_8)
  \/ respond
  \/ isFinished /\ UNCHANGED vars
