  childPaths(path_5, position_4, outcomes[path_5])
statusOf(path) ==
  IF ~(path \in DOMAIN outcomes) THEN "pending" ELSE IF raisesError(path, outcomes[path]) THEN failed(path) ELSE IF outcomes[path].kind = "null" THEN "null" ELSE IF outcomes[path].kind = "leaf" THEN "value" ELSE IF (LET sequence_8 == childrenOf(path, positionOf(path)) IN \E index_10 \in DOMAIN sequence_8 : statusOf(sequence_8[index_10]) = "error") THEN failed(path) ELSE IF (LET sequence_9 == childrenOf(path, positionOf(path)) IN \E index_11 \in DOMAIN sequence_9 : statusOf(sequence_9[index_11]) = "pending") THEN "pending" ELSE "value"
rootStatus ==
  IF \E index_16 \in DOMAIN rootGroups : (~isTypename(rootGroups[index_16])) /\ (statusOf(<<rootGroups[index_16].key>>) = "error") THEN "nulled" ELSE IF \E index_17 \in DOMAIN rootGroups : (~isTypename(rootGroups[index_17])) /\ (statusOf(<<rootGroups[index_17].key>>) = "pending") THEN "pending" ELSE "value"
wrongShapes(position_7) ==
  IF ~fx.invalidResults THEN {} ELSE IF expectedKind(position_7) = "leaf" THEN {[kind |-> "object", type |-> "", length |-> 0]} ELSE IF expectedKind(position_7) = "list" THEN {[kind |-> "leaf", type |-> "", length |-> 0]} ELSE IF fx.schema.types[position_7.type.name].kind = "object" THEN {} ELSE {[kind |-> "object", type |-> t_3, length |-> 0] : t_3 \in {t_2 \in (DOMAIN fx.schema.types) : (fx.schema.types[t_2].kind = "object") /\ (~(t_2 \in fx.schema.types[position_7.type.name].possibleTypes))}}
choicesFor(position_6) ==
  ({[kind |-> "null", type |-> "", length |-> 0], [kind |-> "error", type |-> "", length |-> 0]} \cup (IF expectedKind(position_6) = "list" THEN (LET sequence_15 == [index_20 \in 1..(fx.maxListLength + 1) |-> [kind |-> "list", type |-> "", length |-> (index_20 - 1)]] IN {sequence_15[index_21] : index_21 \in DOMAIN sequence_15}) ELSE IF expectedKind(position_6) = "leaf" THEN {[kind |-> "leaf", type |-> "", length |-> 0]} ELSE {[kind |-> "object", type |-> t_1, length |-> 0] : t_1 \in fx.schema.types[position_6.type.name].possibleTypes})) \cup wrongShapes(position_6)
isInNulledSubtree(path_8) ==
  (rootStatus = "nulled") \/ (LET sequence_16 == [index_22 \in 1..(Len(path_8) - 1) |-> SubSeq(path_8, 1, IF ((index_22 - 1) + 1) < Len(path_8) THEN ((index_22 - 1) + 1) ELSE Len(path_8))] IN \E index_23 \in DOMAIN sequence_16 : (statusOf(sequence_16[index_23]) = "nulled") \/ (statusOf(sequence_16[index_23]) = "error"))
typenameJson(type_4) ==
  [kind |-> "leaf", value |-> type_4, entries |-> <<>>, items |-> <<>>]
LEAF ==
  [kind |-> "leaf", value |-> "", entries |-> <<>>, items |-> <<>>]
jsonOf(path_10) ==
  IF statusOf(path_10) # "value" THEN NULL ELSE IF outcomes[path_10].kind = "leaf" THEN LEAF ELSE IF outcomes[path_10].kind = "list" THEN [kind |-> "list", value |-> "", entries |-> <<>>, items |-> (LET sequence_18 == childrenOf(path_10, positionOf(path_10)) IN [index_26 \in DOMAIN sequence_18 |-> jsonOf(sequence_18[index_26])])] ELSE [kind |-> "object", value |-> "", items |-> <<>>, entries |-> (LET sequence_19 == groupsOf(path_10, positionOf(path_10)) IN [index_27 \in DOMAIN sequence_19 |-> [key |-> sequence_19[index_27].key, value |-> IF isTypename(sequence_19[index_27]) THEN typenameJson(outcomes[path_10].type) ELSE jsonOf(path_10 \o <<sequence_19[index_27].key>>)]])]
responseData ==
  IF rootStatus # "value" THEN NULL ELSE [kind |-> "object", value |-> "", items |-> <<>>, entries |-> [index_25 \in DOMAIN rootGroups |-> [key |-> rootGroups[index_25].key, value |-> IF isTypename(rootGroups[index_25]) THEN typenameJson(rootType) ELSE jsonOf(<<rootGroups[index_25].key>>)]]]
Init ==
  /\ fixture \in {"mutation", "subscription", "fragments", "leaves", "lists", "noPropagation", "nullPropagation", "unions"}
  /\ variant \in {"reportAll", "filterNulled", "cancelNulled"}
  /\ started = FALSE
  /\ startedRoots = 0
  /\ stopped = FALSE
  /\ running = {}
  /\ outcomes = <<>>
  /\ errors = <<>>
  /\ sent = FALSE
  /\ sentData = NULL
  /\ sentErrors = <<>>
start ==
  /\ ~started
  /\ LET count == IF fx.operationType = "mutation" THEN 1 ELSE Len(rootGroups)
         roots == (LET sequence_2 == rootPaths(count) IN {sequence_2[index_3] : index_3 \in DOMAIN sequence_2})
     IN  /\ started' = TRUE
         /\ startedRoots' = count
         /\ running' = roots
         /\ UNCHANGED <<fixture, variant, stopped, outcomes, errors, sent, sentData, sentErrors>>
startNextRootField ==
  /\ (started /\ (~stopped)) /\ (~(fx.operationType # "mutation"))
  /\ ~(startedRoots >= Len(rootPaths(Len(rootGroups))))
  /\ ~(statusOf(rootPaths(startedRoots)[(startedRoots - 1) + 1]) = "pending")
  /\ LET next == (LET sequence_12 == rootPaths(startedRoots + 1) IN {sequence_12[index_14] : index_14 \in DOMAIN sequence_12}) \ (LET sequence_13 == rootPaths(startedRoots) IN {sequence_13[index_15] : index_15 \in DOMAIN sequence_13})
     IN  /\ startedRoots' = startedRoots + 1
         /\ running' = running \cup next
         /\ UNCHANGED <<fixture, variant, started, stopped, outcomes, errors, sent, sentData, sentErrors>>
skipRemainingRootFields ==
  /\ (~stopped) /\ (~(rootStatus # "nulled"))
  /\ stopped' = TRUE
  /\ UNCHANGED <<fixture, variant, started, startedRoots, running, outcomes, errors, sent, sentData, sentErrors>>
settle(path_7, outcome_3) ==
  LET reported == raisesError(path_7, outcome_3) /\ ((variant = "reportAll") \/ (~isInNulledSubtree(path_7)))
      children == (LET sequence_17 == childPaths(path_7, positionOf(path_7), outcome_3) IN {sequence_17[index_24] : index_24 \in DOMAIN sequence_17})
  IN  IF reported
      THEN /\ running' = (running \ {path_7}) \cup children
           /\ outcomes' = (path_7 :> outcome_3) @@ outcomes
           /\ errors' = Append(errors, path_7)
           /\ UNCHANGED <<fixture, variant, started, startedRoots, stopped, sent, sentData, sentErrors>>
      ELSE /\ running' = (running \ {path_7}) \cup children
           /\ outcomes' = (path_7 :> outcome_3) @@ outcomes
           /\ UNCHANGED <<fixture, variant, started, startedRoots, stopped, errors, sent, sentData, sentErrors>>
cancel(path_9) ==
  /\ (~(variant # "cancelNulled")) /\ isInNulledSubtree(path_9)
  /\ running' = running \ {path_9}
  /\ UNCHANGED <<fixture, variant, started, startedRoots, stopped, outcomes, errors, sent, sentData, sentErrors>>
respond ==
  /\ (started /\ (~sent)) /\ (~(rootStatus = "pending"))
  /\ LET data == responseData
     IN  /\ sent' = TRUE
         /\ sentData' = data
         /\ sentErrors' = errors
         /\ UNCHANGED <<fixture, variant, started, startedRoots, stopped, running, outcomes, errors>>
isFinished ==
  (sent /\ (Cardinality(running) = 0)) /\ ((stopped \/ (fx.operationType # "mutation")) \/ (startedRoots = Len(rootPaths(Len(rootGroups)))))
Next ==
  \/ start
  \/ startNextRootField
  \/ skipRemainingRootFields
  \/ \E path_7 \in running : \E outcome_3 \in choicesFor(positionOf(path_7)) : settle(path_7, outcome_3)
  \/ \E path_9 \in running : cancel(path_9)
  \/ respond
  \/ isFinished /\ UNCHANGED vars
Spec ==
  /\ Init
  /\ [][Next]_vars
  /\ WF_vars(start)
  /\ WF_vars(startNextRootField)
  /\ WF_vars(\E path_7 \in running : \E outcome_3 \in choicesFor(positionOf(path_7)) : settle(path_7, outcome_3))
  /\ WF_vars(respond)
====
