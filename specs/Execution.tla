fx ==
  FIXTURES[fixture]
isLocal(scope_5, name_1) ==
  (scope_5.fragment # "") /\ (LET sequence == fx.fragments[scope_5.fragment].variableDefinitions IN \E index \in DOMAIN sequence : sequence[index].name = name_1)
hasValue(scope_4, name) ==
  IF isLocal(scope_4, name) THEN (LET sequence_1 == scope_4.values IN \E index_1 \in DOMAIN sequence_1 : sequence_1[index_1].name = name) ELSE name \in DOMAIN fx.variables
valueOf(scope_6, name_2) ==
  IF isLocal(scope_6, name_2) THEN (LET sequence_2 == scope_6.values IN sequence_2[CHOOSE index_2 \in DOMAIN sequence_2 : (sequence_2[index_2].name = name_2) /\ \A earlier \in 1..(index_2 - 1) : ~(sequence_2[earlier].name = name_2)]).value ELSE IF fx.variables[name_2] THEN "true" ELSE "false"
ifValue(condition, scope_3) ==
  IF condition.kind = "literal" THEN condition.value ELSE hasValue(scope_3, condition.variable) /\ (valueOf(scope_3, condition.variable) = "true")
isIncluded(selection_1, scope_2) ==
  (~((selection_1.skip.kind # "absent") /\ ifValue(selection_1.skip, scope_2))) /\ (~((selection_1.include.kind # "absent") /\ (~ifValue(selection_1.include, scope_2))))
addField(groups, key, field) ==
  IF \E index_3 \in DOMAIN groups : groups[index_3].key = key THEN [index_4 \in DOMAIN groups |-> IF groups[index_4].key = key THEN [key |-> groups[index_4].key, fields |-> groups[index_4].fields \o <<field>>] ELSE groups[index_4]] ELSE groups \o <<[key |-> key, fields |-> <<field>>]>>
applies(objectType_2, condition_1) ==
  IF fx.schema.types[condition_1].kind = "object" THEN objectType_2 = condition_1 ELSE objectType_2 \in fx.schema.types[condition_1].possibleTypes
collectFragment(objectType_3, selection_2, bound, acc_2) ==
  IF bound.ok THEN collect(objectType_3, fx.fragments[selection_2.name].selectionSet, [fragment |-> selection_2.name, values |-> bound.values], 0, [groups |-> acc_2.groups, visited |-> acc_2.visited \cup {selection_2.name}, failed |-> FALSE]) ELSE [groups |-> acc_2.groups, visited |-> acc_2.visited, failed |-> TRUE]
isGiven(args_2, name_3, scope_9) ==
  \E index_5 \in DOMAIN args_2 : (args_2[index_5].name = name_3) /\ ((args_2[index_5].kind = "literal") \/ hasValue(scope_9, args_2[index_5].variable))
givenValue(args_3, name_4, scope_10) ==
  IF args_3[CHOOSE index_6 \in DOMAIN args_3 : (args_3[index_6].name = name_4) /\ \A earlier_1 \in 1..(index_6 - 1) : ~(args_3[earlier_1].name = name_4)].kind = "literal" THEN args_3[CHOOSE index_7 \in DOMAIN args_3 : (args_3[index_7].name = name_4) /\ \A earlier_2 \in 1..(index_7 - 1) : ~(args_3[earlier_2].name = name_4)].value ELSE valueOf(scope_10, args_3[CHOOSE index_8 \in DOMAIN args_3 : (args_3[index_8].name = name_4) /\ \A earlier_3 \in 1..(index_8 - 1) : ~(args_3[earlier_3].name = name_4)].variable)
bindOne(definition, args_1, scope_8, bound_2) ==
  IF isGiven(args_1, definition.name, scope_8) THEN IF definition.nonNull /\ (givenValue(args_1, definition.name, scope_8) = "null") THEN [ok |-> FALSE, values |-> bound_2.values] ELSE [ok |-> TRUE, values |-> bound_2.values \o <<[name |-> definition.name, value |-> givenValue(args_1, definition.name, scope_8)]>>] ELSE IF definition.hasDefault THEN [ok |-> TRUE, values |-> bound_2.values \o <<[name |-> definition.name, value |-> definition.default]>>] ELSE [ok |-> ~definition.nonNull, values |-> bound_2.values]
bind(definitions, args, scope_7, i_1, bound_1) ==
  IF (i_1 >= Len(definitions)) \/ (~bound_1.ok) THEN bound_1 ELSE bind(definitions, args, scope_7, i_1 + 1, bindOne(definitions[i_1 + 1], args, scope_7, bound_1))
collectOne(objectType_1, selection, scope_1, acc_1) ==
  IF ~isIncluded(selection, scope_1) THEN acc_1 ELSE IF selection.kind = "field" THEN [groups |-> addField(acc_1.groups, IF selection.alias = "" THEN selection.name ELSE selection.alias, [field |-> selection, scope |-> scope_1]), visited |-> acc_1.visited, failed |-> FALSE] ELSE IF selection.kind = "inlineFragment" THEN IF (selection.typeCondition # "") /\ (~applies(objectType_1, selection.typeCondition)) THEN acc_1 ELSE collect(objectType_1, selection.selectionSet, scope_1, 0, acc_1) ELSE IF selection.name \in acc_1.visited THEN acc_1 ELSE IF applies(objectType_1, fx.fragments[selection.name].typeCondition) THEN collectFragment(objectType_1, selection, bind(fx.fragments[selection.name].variableDefinitions, selection.arguments, scope_1, 0, [ok |-> TRUE, values |-> <<>>]), acc_1) ELSE [groups |-> acc_1.groups, visited |-> acc_1.visited \cup {selection.name}, failed |-> FALSE]
collect(objectType, selections, scope, i, acc) ==
  IF (i >= Len(selections)) \/ acc.failed THEN acc ELSE collect(objectType, selections, scope, i + 1, collectOne(objectType, selections[i + 1], scope, acc))
rootType ==
  IF fx.operationType = "query" THEN fx.schema.query ELSE IF fx.operationType = "mutation" THEN fx.schema.mutation ELSE fx.schema.subscription
OPERATION ==
  [fragment |-> "", values |-> <<>>]
rootGroups ==
  collect(rootType, fx.operation, OPERATION, 0, [groups |-> <<>>, visited |-> {}, failed |-> FALSE]).groups
isTypename(group) ==
  group.fields[1].field.name = "__typename"
rootPaths(count_1) ==
  (LET sequence_4 == (LET sequence_3 == SelectSeq(rootGroups, LAMBDA g : ~isTypename(g)) IN SubSeq(sequence_3, 1, IF count_1 < Len(sequence_3) THEN count_1 ELSE Len(sequence_3))) IN [index_9 \in DOMAIN sequence_4 |-> <<sequence_4[index_9].key>>])
isList(type) ==
  (Len(type.wrappers) > 0) /\ (type.wrappers[1] = "list")
isNonNull(type_2) ==
  (Len(type_2.wrappers) > 0) /\ (type_2.wrappers[1] = "nonNull")
nullable(type_1) ==
  IF isNonNull(type_1) THEN [name |-> type_1.name, wrappers |-> (LET sequence_6 == type_1.wrappers IN SubSeq(sequence_6, 2, Len(sequence_6)))] ELSE type_1
expectedKind(position_1) ==
  IF isList(nullable(position_1.type)) THEN "list" ELSE IF fx.schema.types[position_1.type.name].kind = "scalar" THEN "leaf" ELSE "object"
isWrongShape(position, outcome_1) ==
  ((outcome_1.kind # "null") /\ (outcome_1.kind # "error")) /\ ((outcome_1.kind # expectedKind(position)) \/ ((outcome_1.kind = "object") /\ (~(outcome_1.type \in fx.schema.types[position.type.name].possibleTypes))))
fieldType(objectType_4, group_1) ==
  fx.schema.types[objectType_4].fields[group_1.fields[1].field.name]
itemType(listType) ==
  [name |-> listType.name, wrappers |-> (LET sequence_7 == listType.wrappers IN SubSeq(sequence_7, 2, Len(sequence_7)))]
collectSubfields(objectType_6, fields_1, i_2, acc_3) ==
  IF (i_2 >= Len(fields_1)) \/ acc_3.failed THEN acc_3 ELSE collectSubfields(objectType_6, fields_1, i_2 + 1, collect(objectType_6, fields_1[i_2 + 1].field.selectionSet, fields_1[i_2 + 1].scope, 0, [groups |-> acc_3.groups, visited |-> {}, failed |-> FALSE]))
subfields(objectType_5, fields) ==
  collectSubfields(objectType_5, fields, 0, [groups |-> <<>>, visited |-> {}, failed |-> FALSE])
groupsOf(path_3, position_3) ==
  subfields(outcomes[path_3].type, position_3.fields).groups
childPosition(parent, position_2, key_1) ==
  IF isList(nullable(position_2.type)) THEN [type |-> itemType(nullable(position_2.type)), fields |-> position_2.fields] ELSE [type |-> fieldType(outcomes[parent].type, (LET sequence_8 == groupsOf(parent, position_2) IN sequence_8[CHOOSE index_13 \in DOMAIN sequence_8 : (sequence_8[index_13].key = key_1) /\ \A earlier_6 \in 1..(index_13 - 1) : ~(sequence_8[earlier_6].key = key_1)])), fields |-> (LET sequence_9 == groupsOf(parent, position_2) IN sequence_9[CHOOSE index_14 \in DOMAIN sequence_9 : (sequence_9[index_14].key = key_1) /\ \A earlier_7 \in 1..(index_14 - 1) : ~(sequence_9[earlier_7].key = key_1)]).fields]
positionOf(path_2) ==
  IF Len(path_2) = 1 THEN [type |-> fieldType(rootType, rootGroups[CHOOSE index_11 \in DOMAIN rootGroups : (rootGroups[index_11].key = path_2[1]) /\ \A earlier_4 \in 1..(index_11 - 1) : ~(rootGroups[earlier_4].key = path_2[1])]), fields |-> rootGroups[CHOOSE index_12 \in DOMAIN rootGroups : (rootGroups[index_12].key = path_2[1]) /\ \A earlier_5 \in 1..(index_12 - 1) : ~(rootGroups[earlier_5].key = path_2[1])].fields] ELSE childPosition(SubSeq(path_2, 1, IF (Len(path_2) - 1) < Len(path_2) THEN (Len(path_2) - 1) ELSE Len(path_2)), positionOf(SubSeq(path_2, 1, IF (Len(path_2) - 1) < Len(path_2) THEN (Len(path_2) - 1) ELSE Len(path_2))), path_2[(Len(path_2) - 1) + 1])
cannotCollect(position_4, outcome_2) ==
  ((outcome_2.kind = "object") /\ (~isWrongShape(position_4, outcome_2))) /\ subfields(outcome_2.type, position_4.fields).failed
raisesError(path_1, outcome) ==
  (((outcome.kind = "error") \/ isWrongShape(positionOf(path_1), outcome)) \/ cannotCollect(positionOf(path_1), outcome)) \/ ((outcome.kind = "null") /\ isNonNull(positionOf(path_1).type))
propagates(type_3) ==
  isNonNull(type_3) /\ fx.errorPropagation
failed(path_4) ==
  IF propagates(positionOf(path_4).type) THEN "error" ELSE "nulled"
childPaths(path_6, position_6, outcome_3) ==
  IF isWrongShape(position_6, outcome_3) \/ cannotCollect(position_6, outcome_3) THEN <<>> ELSE IF outcome_3.kind = "list" THEN [index_15 \in 1..outcome_3.length |-> path_6 \o <<ToString((index_15 - 1))>>] ELSE IF outcome_3.kind = "object" THEN (LET sequence_10 == SelectSeq(subfields(outcome_3.type, position_6.fields).groups, LAMBDA g_1 : ~isTypename(g_1)) IN [index_16 \in DOMAIN sequence_10 |-> path_6 \o <<sequence_10[index_16].key>>]) ELSE <<>>
childrenOf(path_5, position_5) ==
  childPaths(path_5, position_5, outcomes[path_5])
statusOf(path) ==
  IF ~(path \in DOMAIN outcomes) THEN "pending" ELSE IF raisesError(path, outcomes[path]) THEN failed(path) ELSE IF outcomes[path].kind = "null" THEN "null" ELSE IF outcomes[path].kind = "leaf" THEN "value" ELSE IF (LET sequence_11 == childrenOf(path, positionOf(path)) IN \E index_17 \in DOMAIN sequence_11 : statusOf(sequence_11[index_17]) = "error") THEN failed(path) ELSE IF (LET sequence_12 == childrenOf(path, positionOf(path)) IN \E index_18 \in DOMAIN sequence_12 : statusOf(sequence_12[index_18]) = "pending") THEN "pending" ELSE "value"
rootStatus ==
  IF \E index_23 \in DOMAIN rootGroups : (~isTypename(rootGroups[index_23])) /\ (statusOf(<<rootGroups[index_23].key>>) = "error") THEN "nulled" ELSE IF \E index_24 \in DOMAIN rootGroups : (~isTypename(rootGroups[index_24])) /\ (statusOf(<<rootGroups[index_24].key>>) = "pending") THEN "pending" ELSE "value"
wrongShapes(position_8) ==
  IF ~fx.invalidResults THEN {} ELSE IF expectedKind(position_8) = "leaf" THEN {[kind |-> "object", type |-> "", length |-> 0]} ELSE IF expectedKind(position_8) = "list" THEN {[kind |-> "leaf", type |-> "", length |-> 0]} ELSE IF fx.schema.types[position_8.type.name].kind = "object" THEN {} ELSE {[kind |-> "object", type |-> t_3, length |-> 0] : t_3 \in {t_2 \in (DOMAIN fx.schema.types) : (fx.schema.types[t_2].kind = "object") /\ (~(t_2 \in fx.schema.types[position_8.type.name].possibleTypes))}}
choicesFor(position_7) ==
  ({[kind |-> "null", type |-> "", length |-> 0], [kind |-> "error", type |-> "", length |-> 0]} \cup (IF expectedKind(position_7) = "list" THEN (LET sequence_18 == [index_27 \in 1..(fx.maxListLength + 1) |-> [kind |-> "list", type |-> "", length |-> (index_27 - 1)]] IN {sequence_18[index_28] : index_28 \in DOMAIN sequence_18}) ELSE IF expectedKind(position_7) = "leaf" THEN {[kind |-> "leaf", type |-> "", length |-> 0]} ELSE {[kind |-> "object", type |-> t_1, length |-> 0] : t_1 \in fx.schema.types[position_7.type.name].possibleTypes})) \cup wrongShapes(position_7)
isInNulledSubtree(path_8) ==
  (rootStatus = "nulled") \/ (LET sequence_19 == [index_29 \in 1..(Len(path_8) - 1) |-> SubSeq(path_8, 1, IF ((index_29 - 1) + 1) < Len(path_8) THEN ((index_29 - 1) + 1) ELSE Len(path_8))] IN \E index_30 \in DOMAIN sequence_19 : (statusOf(sequence_19[index_30]) = "nulled") \/ (statusOf(sequence_19[index_30]) = "error"))
typenameJson(type_4) ==
  [kind |-> "leaf", value |-> type_4, entries |-> <<>>, items |-> <<>>]
LEAF ==
  [kind |-> "leaf", value |-> "", entries |-> <<>>, items |-> <<>>]
jsonOf(path_10) ==
  IF statusOf(path_10) # "value" THEN NULL ELSE IF outcomes[path_10].kind = "leaf" THEN LEAF ELSE IF outcomes[path_10].kind = "list" THEN [kind |-> "list", value |-> "", entries |-> <<>>, items |-> (LET sequence_21 == childrenOf(path_10, positionOf(path_10)) IN [index_33 \in DOMAIN sequence_21 |-> jsonOf(sequence_21[index_33])])] ELSE [kind |-> "object", value |-> "", items |-> <<>>, entries |-> (LET sequence_22 == groupsOf(path_10, positionOf(path_10)) IN [index_34 \in DOMAIN sequence_22 |-> [key |-> sequence_22[index_34].key, value |-> IF isTypename(sequence_22[index_34]) THEN typenameJson(outcomes[path_10].type) ELSE jsonOf(path_10 \o <<sequence_22[index_34].key>>)]])]
responseData ==
  IF rootStatus # "value" THEN NULL ELSE [kind |-> "object", value |-> "", items |-> <<>>, entries |-> [index_32 \in DOMAIN rootGroups |-> [key |-> rootGroups[index_32].key, value |-> IF isTypename(rootGroups[index_32]) THEN typenameJson(rootType) ELSE jsonOf(<<rootGroups[index_32].key>>)]]]
Init ==
  /\ fixture \in {"mutation", "subscription", "abstract", "abstractList", "aliases", "booleanResult", "conditionalMerge_on", "conditionalMerge_off", "deepLists", "directives_kept", "directives_skipped", "directives_excluded", "directives_dropped", "fragmentArguments_on", "fragmentArguments_off", "fragmentArgumentsDetails", "fragmentArgumentsNull", "fragments", "leaves", "listPartialNull", "lists", "merging", "mutationRoot", "nestedLists", "noPropagation", "nonNullListItems", "nullPropagation", "ordering", "scalars", "subscriptionAlias", "unions"}
  /\ variant \in {"reportAll", "filterNulled", "cancelNulled"}
  /\ started = FALSE
  /\ startedRoots = 0
  /\ stopped = FALSE
  /\ running = {}
  /\ outcomes = <<>>
  /\ errors = <<>>
  /\ sent = FALSE
  /\ sentData = NULL
  /\ sentErrors = <<>>
start ==
  /\ ~started
  /\ LET count == IF fx.operationType = "mutation" THEN 1 ELSE Len(rootGroups)
         roots == (LET sequence_5 == rootPaths(count) IN {sequence_5[index_10] : index_10 \in DOMAIN sequence_5})
     IN  /\ started' = TRUE
         /\ startedRoots' = count
         /\ running' = roots
         /\ UNCHANGED <<fixture, variant, stopped, outcomes, errors, sent, sentData, sentErrors>>
startNextRootField ==
  /\ (started /\ (~stopped)) /\ (~(fx.operationType # "mutation"))
  /\ ~(startedRoots >= Len(rootPaths(Len(rootGroups))))
  /\ ~(statusOf(rootPaths(startedRoots)[(startedRoots - 1) + 1]) = "pending")
  /\ LET next == (LET sequence_15 == rootPaths(startedRoots + 1) IN {sequence_15[index_21] : index_21 \in DOMAIN sequence_15}) \ (LET sequence_16 == rootPaths(startedRoots) IN {sequence_16[index_22] : index_22 \in DOMAIN sequence_16})
     IN  /\ startedRoots' = startedRoots + 1
         /\ running' = running \cup next
         /\ UNCHANGED <<fixture, variant, started, stopped, outcomes, errors, sent, sentData, sentErrors>>
skipRemainingRootFields ==
  /\ (~stopped) /\ (~(rootStatus # "nulled"))
  /\ stopped' = TRUE
  /\ UNCHANGED <<fixture, variant, started, startedRoots, running, outcomes, errors, sent, sentData, sentErrors>>
settle(path_7, outcome_4) ==
  LET reported == raisesError(path_7, outcome_4) /\ ((variant = "reportAll") \/ (~isInNulledSubtree(path_7)))
      children == (LET sequence_20 == childPaths(path_7, positionOf(path_7), outcome_4) IN {sequence_20[index_31] : index_31 \in DOMAIN sequence_20})
  IN  IF reported
      THEN /\ running' = (running \ {path_7}) \cup children
           /\ outcomes' = (path_7 :> outcome_4) @@ outcomes
           /\ errors' = Append(errors, path_7)
           /\ UNCHANGED <<fixture, variant, started, startedRoots, stopped, sent, sentData, sentErrors>>
      ELSE /\ running' = (running \ {path_7}) \cup children
           /\ outcomes' = (path_7 :> outcome_4) @@ outcomes
           /\ UNCHANGED <<fixture, variant, started, startedRoots, stopped, errors, sent, sentData, sentErrors>>
cancel(path_9) ==
  /\ (~(variant # "cancelNulled")) /\ isInNulledSubtree(path_9)
  /\ running' = running \ {path_9}
  /\ UNCHANGED <<fixture, variant, started, startedRoots, stopped, outcomes, errors, sent, sentData, sentErrors>>
respond ==
  /\ (started /\ (~sent)) /\ (~(rootStatus = "pending"))
  /\ LET data == responseData
     IN  /\ sent' = TRUE
         /\ sentData' = data
         /\ sentErrors' = errors
         /\ UNCHANGED <<fixture, variant, started, startedRoots, stopped, running, outcomes, errors>>
isFinished ==
  (sent /\ (Cardinality(running) = 0)) /\ ((stopped \/ (fx.operationType # "mutation")) \/ (startedRoots = Len(rootPaths(Len(rootGroups)))))
Next ==
  \/ start
  \/ startNextRootField
  \/ skipRemainingRootFields
  \/ \E path_7 \in running : \E outcome_4 \in choicesFor(positionOf(path_7)) : settle(path_7, outcome_4)
  \/ \E path_9 \in running : cancel(path_9)
  \/ respond
  \/ isFinished /\ UNCHANGED vars
Spec ==
  /\ Init
  /\ [][Next]_vars
  /\ WF_vars(start)
  /\ WF_vars(startNextRootField)
  /\ WF_vars(\E path_7 \in running : \E outcome_4 \in choicesFor(positionOf(path_7)) : settle(path_7, outcome_4))
  /\ WF_vars(respond)
====
