cancel ==
  /\ (initialSent /\ hasNext) /\ (~cancelled)
  /\ stream' = "stopped"
  /\ cancelled' = TRUE
  /\ UNCHANGED <<nonNullItems, title, source, yielded, returned, item, initialSent, hasNext, announced, completed, payloads, feedData, itemsData, held, errors>>
responseOver ==
  (initialSent /\ ((~hasNext) \/ cancelled)) \/ ((stream = "none") /\ (source = "hung"))
Next ==
  \/ \E outcome \in {"error", "value"} : resolveTitle(outcome)
  \/ pullNext
  \/ \E outcome_1 \in {"done", "item", "throw", "hang"} : sourceRespond(outcome_1)
  \/ \E i \in {0, 1, 2}, outcome_2 \in {"ok", "error"} : completeItem(i, outcome_2)
  \/ closeSource
  \/ sendInitial
  \/ \E first \in {0, 1, 2, 3}, count \in {0, 1, 2}, finish \in BOOLEAN : sendSubsequent(first, count, finish)
  \/ cancel
  \/ responseOver /\ UNCHANGED vars
Spec ==
  /\ Init
  /\ [][Next]_vars
  /\ \A outcome \in {"error", "value"} : WF_vars(resolveTitle(outcome))
  /\ WF_vars(pullNext)
  /\ \A outcome_1 \in {"done", "item", "throw", "hang"} : WF_vars(sourceRespond(outcome_1))
  /\ \A i \in {0, 1, 2}, outcome_2 \in {"ok", "error"} : WF_vars(completeItem(i, outcome_2))
  /\ WF_vars(closeSource)
  /\ WF_vars(sendInitial)
  /\ \A first \in {0, 1, 2, 3}, count \in {0, 1, 2}, finish \in BOOLEAN : WF_vars(sendSubsequent(first, count, finish))
clientHoldsSourcePrefix ==
  \A index \in DOMAIN held : ((held[index].item = (index - 1)) /\ ((index - 1) < yielded)) /\ (IF held[index].value = "null" THEN (item[(index - 1)] = "error") /\ (~nonNullItems) ELSE item[(index - 1)] = "ok")
errorsAreReal ==
  \A index_1 \in DOMAIN errors : (((((errors[index_1] = "title") /\ (title = "error")) \/ ((errors[index_1] = "items") /\ (source = "threw"))) \/ ((errors[index_1] = "name0") /\ (item[0] = "error"))) \/ ((errors[index_1] = "name1") /\ (item[1] = "error"))) \/ ((errors[index_1] = "name2") /\ (item[2] = "error"))
oneErrorPerPath ==
  \A p \in ERROR_PATHS : Len(SelectSeq(errors, LAMBDA e : e = p)) <= 1
nullsAreExplained ==
  (((feedData # "null") \/ received("title")) /\ (((itemsData # "null") \/ received("items")) \/ received("name0"))) /\ (\A index_3 \in DOMAIN held : (held[index_3].value # "null") \/ received(NAME_ERRORS[(index_3 - 1) + 1]))
announcedUnderLiveParent ==
  (~announced) \/ ((feedData = "object") /\ (itemsData = "list"))
completedWereAnnounced ==
  (completed = "none") \/ announced
hasNextIsHonest ==
  ((~initialSent) \/ cancelled) \/ (hasNext = (announced /\ (completed = "none")))
nothingIsRetracted ==
  [][(((Len(held) <= Len(held')) /\ (\A index_4 \in DOMAIN held : held'[(index_4 - 1) + 1] = held[index_4])) /\ ((feedData = "unset") \/ (feedData' = feedData))) /\ ((itemsData = "unset") \/ (itemsData' = itemsData))]_vars
nothingAfterTheEnd ==
  [][(~(cancelled \/ (initialSent /\ (~hasNext)))) \/ (payloads' = payloads)]_vars
announcedStreamCompletes ==
  (announced) ~> streamSettled
abandonedIteratorIsClosed ==
  (abandoned /\ (~((stream = "none") /\ ((source = "pulling") \/ (source = "hung"))))) ~> iteratorReleased
====
