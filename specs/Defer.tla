  <>(isClosed /\ (\A g_24 \in pending : completions[g_24] > 0))
hasNextLeadsToAnotherPayload ==
  \A n \in {1, 2, 3} : ((initialSent /\ hasNext) /\ (payloads = n)) ~> sentMoreThan(n)
====
